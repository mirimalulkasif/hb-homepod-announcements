{
  "pluginAlias": "HomePodAnnouncements",
  "pluginType": "platform",
  "singular": true,
  "headerDisplay": "Momentary switches that speak text on a HomePod. TTS is bundled; pyatv is installed into the plugin on npm install. Set homepodId from atvremote scan. Home app: tap the switch → HomePod talks → switch turns off.",
  "schema": {
    "type": "object",
    "properties": {
      "name": {
        "title": "Name",
        "type": "string",
        "default": "HomePod Announcements",
        "required": true
      },
      "homepodId": {
        "title": "Default HomePod id",
        "type": "string",
        "description": "From `atvremote scan` (MAC / identifier). Required for pyatv playback unless every announcement sets its own id.",
        "required": true
      },
      "volume": {
        "title": "Default volume (0–100)",
        "type": "integer",
        "default": 50,
        "minimum": 0,
        "maximum": 100
      },
      "voice": {
        "title": "Default TTS voice",
        "type": "string",
        "default": "he-IL-HilaNeural",
        "description": "Microsoft Edge neural voice (bundled). Examples: he-IL-HilaNeural, en-US-JennyNeural."
      },
      "language": {
        "title": "Language (optional)",
        "type": "string",
        "description": "Usually inferred from the voice (e.g. he-IL). Override only if needed."
      },
      "playback": {
        "title": "Playback",
        "type": "string",
        "default": "auto",
        "oneOf": [
          { "title": "Auto (homepod-radio media folder if present, else pyatv)", "enum": ["auto"] },
          { "title": "pyatv (atvremote stream_file)", "enum": ["pyatv"] },
          { "title": "homebridge-homepod-radio /play", "enum": ["homepod-radio"] }
        ]
      },
      "homepodRadioPlayBase": {
        "title": "homepod-radio play URL",
        "type": "string",
        "default": "http://127.0.0.1:7654/play",
        "description": "Only used when playback is auto/homepod-radio."
      },
      "mediaPath": {
        "title": "Media folder for homepod-radio",
        "type": "string",
        "default": "/var/www/tones"
      },
      "httpPort": {
        "title": "HTTP announce port (0 = off)",
        "type": "integer",
        "default": 0,
        "minimum": 0,
        "description": "POST /announce {\"text\":\"...\"} for dynamic phrases from other automations."
      },
      "announcements": {
        "title": "Announcement switches",
        "type": "array",
        "required": true,
        "items": {
          "type": "object",
          "properties": {
            "name": {
              "title": "Switch name",
              "type": "string",
              "required": true,
              "default": "Dinner ready"
            },
            "text": {
              "title": "Spoken text",
              "type": "string",
              "required": true,
              "default": "Dinner is ready"
            },
            "homepodId": {
              "title": "HomePod id override",
              "type": "string"
            },
            "volume": {
              "title": "Volume override",
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            },
            "voice": {
              "title": "Voice override",
              "type": "string"
            }
          }
        }
      }
    }
  }
}
