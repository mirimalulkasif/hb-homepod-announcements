{
  "pluginAlias": "HomePodAnnouncements",
  "pluginType": "platform",
  "singular": true,
  "headerDisplay": "Momentary switches that speak text on a HomePod. Pick a voice and speaking style (cheer, whisper, announcer, …). TTS is bundled; pyatv is set up on install.",
  "schema": {
    "type": "object",
    "properties": {
      "name": {
        "title": "Name",
        "type": "string",
        "default": "HomePod Announcements",
        "required": true
      },
      "homepodId": {
        "title": "Default HomePod id",
        "type": "string",
        "description": "From `atvremote scan` (MAC / identifier). Required for pyatv playback unless every announcement sets its own id.",
        "required": true
      },
      "volume": {
        "title": "Default volume (0–100)",
        "type": "integer",
        "default": 50,
        "minimum": 0,
        "maximum": 100
      },
      "voice": {
        "title": "Default voice",
        "type": "string",
        "default": "hila",
        "oneOf": [
          { "title": "Hila (Hebrew · female)", "enum": ["hila"] },
          { "title": "Avri (Hebrew · male)", "enum": ["avri"] },
          { "title": "Ava (multilingual · female)", "enum": ["ava"] },
          { "title": "Emma (multilingual · female)", "enum": ["emma"] },
          { "title": "Andrew (multilingual · male)", "enum": ["andrew"] },
          { "title": "Brian (multilingual · male)", "enum": ["brian"] },
          { "title": "Jenny (English · female)", "enum": ["jenny"] },
          { "title": "Guy (English · male)", "enum": ["guy"] },
          { "title": "Aria (English · female)", "enum": ["aria"] },
          { "title": "Davis (English · male)", "enum": ["davis"] },
          { "title": "Sara (English · female)", "enum": ["sara"] },
          { "title": "Tony (English · male)", "enum": ["tony"] }
        ],
        "description": "Microsoft Edge neural voice (bundled, free, no API key)."
      },
      "style": {
        "title": "Default speaking style",
        "type": "string",
        "default": "normal",
        "oneOf": [
          { "title": "Normal", "enum": ["normal"] },
          { "title": "Cheerful", "enum": ["cheerful"] },
          { "title": "Calm & quiet", "enum": ["calm"] },
          { "title": "Whisper", "enum": ["whisper"] },
          { "title": "Announcer", "enum": ["announcer"] },
          { "title": "Urgent warning", "enum": ["urgent"] },
          { "title": "Warm & loving", "enum": ["warm"] },
          { "title": "Excited", "enum": ["excited"] },
          { "title": "Playful / funny", "enum": ["funny"] }
        ],
        "description": "Approximated with Edge TTS rate/pitch (same style list as homebridge-homepod-israel-hebrew)."
      },
      "language": {
        "title": "Language (optional)",
        "type": "string",
        "description": "Usually inferred from the voice (e.g. he-IL). Override only if needed."
      },
      "playback": {
        "title": "Playback",
        "type": "string",
        "default": "auto",
        "oneOf": [
          { "title": "Auto (homepod-radio media folder if present, else pyatv)", "enum": ["auto"] },
          { "title": "pyatv (atvremote stream_file)", "enum": ["pyatv"] },
          { "title": "homebridge-homepod-radio /play", "enum": ["homepod-radio"] }
        ]
      },
      "homepodRadioPlayBase": {
        "title": "homepod-radio play URL",
        "type": "string",
        "default": "http://127.0.0.1:7654/play",
        "description": "Only used when playback is auto/homepod-radio."
      },
      "mediaPath": {
        "title": "Media folder for homepod-radio",
        "type": "string",
        "default": "/var/www/tones"
      },
      "httpPort": {
        "title": "HTTP announce port (0 = off)",
        "type": "integer",
        "default": 0,
        "minimum": 0,
        "description": "POST /announce {\"text\":\"...\"} for dynamic phrases from other automations."
      },
      "announcements": {
        "title": "Announcement switches",
        "type": "array",
        "required": true,
        "items": {
          "type": "object",
          "properties": {
            "name": {
              "title": "Switch name",
              "type": "string",
              "required": true,
              "default": "Dinner ready"
            },
            "text": {
              "title": "Spoken text",
              "type": "string",
              "required": true,
              "default": "Dinner is ready"
            },
            "homepodId": {
              "title": "HomePod id override",
              "type": "string"
            },
            "volume": {
              "title": "Volume override",
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            },
            "voice": {
              "title": "Voice (optional override)",
              "type": "string",
              "oneOf": [
                { "title": "Hila (Hebrew · female)", "enum": ["hila"] },
                { "title": "Avri (Hebrew · male)", "enum": ["avri"] },
                { "title": "Ava (multilingual · female)", "enum": ["ava"] },
                { "title": "Emma (multilingual · female)", "enum": ["emma"] },
                { "title": "Andrew (multilingual · male)", "enum": ["andrew"] },
                { "title": "Brian (multilingual · male)", "enum": ["brian"] },
                { "title": "Jenny (English · female)", "enum": ["jenny"] },
                { "title": "Guy (English · male)", "enum": ["guy"] },
                { "title": "Aria (English · female)", "enum": ["aria"] },
                { "title": "Davis (English · male)", "enum": ["davis"] },
                { "title": "Sara (English · female)", "enum": ["sara"] },
                { "title": "Tony (English · male)", "enum": ["tony"] }
              ],
              "description": "Omit to use the platform default voice."
            },
            "style": {
              "title": "Speaking style (optional override)",
              "type": "string",
              "oneOf": [
                { "title": "Normal", "enum": ["normal"] },
                { "title": "Cheerful", "enum": ["cheerful"] },
                { "title": "Calm & quiet", "enum": ["calm"] },
                { "title": "Whisper", "enum": ["whisper"] },
                { "title": "Announcer", "enum": ["announcer"] },
                { "title": "Urgent warning", "enum": ["urgent"] },
                { "title": "Warm & loving", "enum": ["warm"] },
                { "title": "Excited", "enum": ["excited"] },
                { "title": "Playful / funny", "enum": ["funny"] }
              ],
              "description": "Omit to use the platform default style."
            }
          }
        }
      }
    }
  }
}
