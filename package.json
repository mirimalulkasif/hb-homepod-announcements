{
  "name": "homebridge-homepod-announcements",
  "displayName": "HomePod Announcements",
  "version": "0.3.0",
  "description": "Momentary HomeKit switches that speak configured phrases on a HomePod. Bundles Edge TTS; sets up pyatv on install.",
  "license": "Apache-2.0",
  "author": "mirimalulkasif",
  "homepage": "https://github.com/mirimalulkasif/hb-homepod-announcements#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mirimalulkasif/hb-homepod-announcements.git"
  },
  "bugs": {
    "url": "https://github.com/mirimalulkasif/hb-homepod-announcements/issues"
  },
  "keywords": [
    "homebridge-plugin",
    "supports-hap",
    "homepod",
    "airplay",
    "tts",
    "announcement",
    "pyatv"
  ],
  "engines": {
    "node": ">=18.0.0",
    "homebridge": "^1.6.0 || ^2.0.0"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "scripts",
    "config.schema.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "test": "HB_ANNOUNCE_SKIP_PYATV=1 npm run build && node --test test/*.test.js",
    "postinstall": "node scripts/postinstall.js",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "node-edge-tts": "^1.2.12"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "homebridge": "^1.11.0",
    "typescript": "^5.9.0"
  },
  "peerDependencies": {
    "homebridge": "^1.6.0 || ^2.0.0"
  }
}
